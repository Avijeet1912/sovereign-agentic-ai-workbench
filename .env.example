# Backend configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend configuration
VITE_API_URL=http://127.0.0.1:8000

# AI configuration
# Install Ollama: https://ollama.com
# Pull a small model: ollama pull phi3:mini
